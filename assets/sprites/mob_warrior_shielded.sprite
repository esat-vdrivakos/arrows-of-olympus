title "Greek Hoplite Warrior (Shielded)"
type sprite
size 64x64
fps 10
palette neogeo
outline #141020
light -0.5,-0.7

ramp bronze_plate #4A2810 #8C5220 #D48B3B #FFE08A
ramp royal_azure  #10264A #1D4E89 #348AC7 #8CE2FF
ramp aspis_gold   #5C3409 #A86614 #E8AD28 #FFF294

part shadow ramp=obsidian z=-10 pivot=32,56
  box 32,56 13,3.2 r=2.0 step=0

part cape ramp=royal_azure z=-5 pivot=32,26
  poly 20,25 44,25 48,50 16,50 r=2.0

part leg_l ramp=bronze_plate z=-2 pivot=27,43
  capsule 27,43 26,54 r=3.6

part leg_r ramp=bronze_plate z=-1 pivot=37,43
  capsule 37,43 38,54 r=3.6

part cuirass ramp=bronze_plate z=0 pivot=32,34 dither=bayer2
  box 32,33 11.0,9.0 r=3.0
  box 32,42 10.5,4.0 r=1.5 ramp=royal_azure

part helmet ramp=bronze_plate z=4 pivot=32,18
  poly 22,6 42,6 45,14 19,14 r=2.5 ramp=royal_azure
  circle 32,19 r=8.2
  box 32,22 7.5,4.8 r=1.5
  box 32,21 5.2,1.6 step=0 ramp=obsidian
  pixel 28,20 w=3 h=2 step=3 ramp=aspis_gold
  pixel 34,20 w=3 h=2 step=3 ramp=aspis_gold

part arm_r ramp=bronze_plate z=1 pivot=43,30
  capsule 43,30 48,37 r=3.2

part spear ramp=steel z=2 pivot=46,34
  line 38,48 58,10 thick=2.4 ramp=wood
  poly 55,14 61,5 59,17 ramp=steel

part aspis_shield ramp=aspis_gold z=7 pivot=23,35 dither=bayer2
  circle 23,35 r=11.5
  ring 23,35 r=10.5 thick=2.0 ramp=bronze_plate
  poly 23,28 18,40 20,40 23,32 26,40 28,40 ramp=royal_azure

part slash_arc ramp=aspis_gold z=9 hidden=true pivot=48,32
  poly 48,14 59,24 61,36 52,48 54,34 46,22 r=1.5
  poly 52,18 60,28 56,42 54,30 r=1.0 ramp=royal_azure

part range_flash ramp=aspis_gold z=9 hidden=true pivot=55,28
  poly 55,20 58,26 62,28 58,30 55,36 53,30 49,28 53,26
  circle 55,28 r=2.4 ramp=royal_azure

tag idle frames=4 duration=120ms loop=pingpong
  pose cuirass dy=sin(1.0)
  pose helmet dy=sin(1.0)
  pose aspis_shield dy=sin(1.2)
  pose spear dy=sin(1.0)

tag run frames=4 duration=95ms loop=loop
  pose cuirass dy=abs_sin(1.8)
  pose helmet dy=abs_sin(1.8)
  pose leg_l dy=sin(3.5) rot=sin(16.0)
  pose leg_r dy=cos(3.5) rot=cos(16.0)
  pose aspis_shield dy=sin(1.5) dx=cos(1.0)
  pose spear dx=sin(2.5) dy=cos(1.5)

tag shield_guard frames=4 duration=100ms loop=pingpong
  pose aspis_shield dx=4 dy=-1 scale=1.12
  pose helmet dy=1
  pose spear rot=12 dx=2

// Shared Melee Attack Profile (Wind-up Back-lean -> Forward Lunge + Wide Cleave/Thrust Arc -> Recovery)
tag attack frames=4 duration=75ms loop=once
  pose spear f=0..0 rot=-45 dx=-3 dy=-2
  pose spear f=1..2 rot=-15->65 dx=5 dy=2 scale=1.18 ease=out_quad
  pose spear f=3..3 rot=35->0 dx=0 dy=0
  pose slash_arc visible=true f=1..2 dx=0->3 rot=-15->25 scale=1.12 squash=0.0->0.10 ease=out_quad
  pose arm_r f=0..0 rot=-35 dx=-2
  pose arm_r f=1..2 rot=-15->50 dx=3 ease=out_quad
  pose arm_r f=3..3 rot=15->0
  pose aspis_shield f=0..1 dx=0->-3
  pose aspis_shield f=2..3 dx=-3->0
  pose cuirass f=0..0 dx=-2 rot=-6
  pose cuirass f=1..2 dx=0->4 rot=10 squash=-0.08 ease=out_quad
  pose cuirass f=3..3 dx=2->0 rot=4->0

tag melee_attack frames=4 duration=75ms loop=once
  pose spear f=0..0 rot=-45 dx=-3 dy=-2
  pose spear f=1..2 rot=-15->65 dx=5 dy=2 scale=1.18 ease=out_quad
  pose spear f=3..3 rot=35->0 dx=0 dy=0
  pose slash_arc visible=true f=1..2 dx=0->3 rot=-15->25 scale=1.12 squash=0.0->0.10 ease=out_quad
  pose arm_r f=0..0 rot=-35 dx=-2
  pose arm_r f=1..2 rot=-15->50 dx=3 ease=out_quad
  pose arm_r f=3..3 rot=15->0
  pose aspis_shield f=0..1 dx=0->-3
  pose aspis_shield f=2..3 dx=-3->0
  pose cuirass f=0..0 dx=-2 rot=-6
  pose cuirass f=1..2 dx=0->4 rot=10 squash=-0.08 ease=out_quad
  pose cuirass f=3..3 dx=2->0 rot=4->0

// Shared Ranged Attack Profile (Draw/Aim Tension -> Release Snap + Flash -> Recoil Recovery)
tag ranged_attack frames=4 duration=75ms loop=once
  pose spear f=0..1 dx=0->-4 dy=0->-2 rot=0->-20 scale=1.10 squash=0.0->0.08
  pose spear f=2..3 dx=5->0 dy=-2->0 rot=18->0 ease=out_quad
  pose arm_r f=0..1 dx=0->-4 rot=0->-22
  pose arm_r f=2..3 dx=3->0 rot=12->0 ease=out_quad
  pose aspis_shield f=0..1 dx=0->2
  pose aspis_shield f=2..3 dx=-2->0
  pose cuirass f=0..1 dx=0->-3 rot=0->-6 squash=0.0->0.06
  pose cuirass f=2..3 dx=2->0 rot=5->0 squash=-0.08->0.0 ease=out_quad
  pose helmet f=0..1 dx=0->-2
  pose helmet f=2..3 dx=2->0
  pose range_flash visible=true f=2..2 dx=2 scale=1.2

tag hit frames=2 duration=90ms loop=once
  pose cuirass dx=-3->0
  pose aspis_shield dx=-2->0 squash=-0.10->0.0

tag death frames=4 duration=110ms loop=once
  pose cuirass f=0..3 dy=0->13 rot=0->68
  pose helmet f=0..3 dy=0->15 rot=0->72
  pose aspis_shield f=0..3 dy=0->14 dx=0->-8 rot=0->-45
