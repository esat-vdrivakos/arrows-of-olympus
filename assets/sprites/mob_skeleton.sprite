title "Skeleton Spartoi"
type sprite
size 64x64
fps 10
palette bloodmoon
outline #141020
light -0.5,-0.7

ramp cursed_bone #4A3E42 #877875 #C7B8AC #F7F0E4
ramp rust_bronze #3B2014 #6E3D22 #A86438 #E09B60
ramp necromancy  #4A0E24 #9E193C #EB3858 #FF94A6

part shadow ramp=obsidian z=-10 pivot=32,56
  box 32,56 10,2.5 r=1.5 step=0

part leg_l ramp=cursed_bone z=-2 pivot=28,43
  capsule 28,43 26,54 r=2.2

part leg_r ramp=cursed_bone z=-1 pivot=36,43
  capsule 36,43 38,54 r=2.2

part pelvis ramp=cursed_bone z=0 pivot=32,41
  box 32,41 6.5,2.5 r=1.0
  box 32,42 7.0,2.0 r=0.8 ramp=rust_bronze

part ribs ramp=cursed_bone z=1 pivot=32,32
  box 32,32 7.5,6.5 r=2.0
  line 27,29 37,29 thick=1.6 ramp=obsidian
  line 27,33 37,33 thick=1.6 ramp=obsidian
  circle 32,32 r=2.5 ramp=necromancy

part skull ramp=cursed_bone z=4 pivot=32,19
  circle 32,18 r=7.0
  box 32,23 4.5,3.0 r=1.0
  poly 25,13 32,6 39,13 r=1.2 ramp=rust_bronze
  poly 30,6 32,2 34,6 ramp=necromancy
  pixel 28,17 w=3 h=3 step=3 ramp=necromancy
  pixel 34,17 w=3 h=3 step=3 ramp=necromancy
  pixel 31,20 w=2 h=2 step=0 ramp=obsidian

part arm_l ramp=cursed_bone z=2 pivot=23,29
  capsule 23,29 19,38 r=2.1
  circle 19,39 r=3.5 ramp=rust_bronze

part arm_r ramp=cursed_bone z=5 pivot=41,29
  capsule 41,29 46,37 r=2.1

part kopis ramp=steel z=6 pivot=46,36
  capsule 46,36 55,23 r=2.2
  capsule 52,26 57,20 r=2.5
  box 45,37 3.0,1.5 ramp=rust_bronze

part bone_bow ramp=cursed_bone z=6 hidden=true pivot=47,33
  capsule 45,20 51,33 r=1.8
  capsule 51,33 45,46 r=1.8
  line 44,21 44,45 thick=1.1 ramp=necromancy
  line 42,33 54,33 thick=1.8 ramp=necromancy

part slash_arc ramp=necromancy z=9 hidden=true pivot=48,32
  poly 48,14 59,24 61,36 52,48 54,34 46,22 r=1.5
  poly 52,18 60,28 56,42 54,30 r=1.0 ramp=cursed_bone

part range_flash ramp=necromancy z=9 hidden=true pivot=54,33
  poly 54,25 57,31 61,33 57,35 54,41 52,35 48,33 52,31
  circle 54,33 r=2.2 ramp=cursed_bone

tag idle frames=4 duration=120ms loop=pingpong
  pose ribs dy=sin(1.2)
  pose skull dy=sin(1.5) rot=sin(3.0)
  pose arm_r rot=sin(5.0)
  pose kopis rot=sin(6.0)

tag run frames=4 duration=85ms loop=loop
  pose ribs dy=abs_sin(2.0) rot=sin(5.0)
  pose skull dy=abs_sin(2.5) rot=cos(4.0)
  pose leg_l dy=sin(4.0) rot=sin(22.0)
  pose leg_r dy=cos(4.0) rot=cos(22.0)
  pose arm_l rot=cos(15.0)
  pose arm_r rot=sin(18.0)
  pose kopis rot=sin(20.0) dy=sin(2.0)

// Shared Melee Attack Profile (Wind-up Back-lean -> Forward Lunge + Wide Cleave Arc -> Recovery)
tag attack frames=4 duration=75ms loop=once
  pose kopis visible=true f=0..0 rot=-55 dx=-2 dy=-4
  pose kopis visible=true f=1..2 rot=-20->75 dx=4 dy=2 scale=1.18 ease=out_quad
  pose kopis visible=true f=3..3 rot=40->0 dx=0 dy=0
  pose bone_bow visible=false f=0..3
  pose slash_arc visible=true f=1..2 dx=0->3 rot=-15->25 scale=1.12 squash=0.0->0.10 ease=out_quad
  pose arm_r f=0..0 rot=-40 dx=-2
  pose arm_r f=1..2 rot=-20->55 dx=3 ease=out_quad
  pose arm_r f=3..3 rot=15->0
  pose ribs f=0..0 dx=-2 rot=-6
  pose ribs f=1..2 dx=0->4 rot=10 squash=-0.08 ease=out_quad
  pose ribs f=3..3 dx=2->0 rot=4->0

tag melee_attack frames=4 duration=75ms loop=once
  pose kopis visible=true f=0..0 rot=-55 dx=-2 dy=-4
  pose kopis visible=true f=1..2 rot=-20->75 dx=4 dy=2 scale=1.18 ease=out_quad
  pose kopis visible=true f=3..3 rot=40->0 dx=0 dy=0
  pose bone_bow visible=false f=0..3
  pose slash_arc visible=true f=1..2 dx=0->3 rot=-15->25 scale=1.12 squash=0.0->0.10 ease=out_quad
  pose arm_r f=0..0 rot=-40 dx=-2
  pose arm_r f=1..2 rot=-20->55 dx=3 ease=out_quad
  pose arm_r f=3..3 rot=15->0
  pose ribs f=0..0 dx=-2 rot=-6
  pose ribs f=1..2 dx=0->4 rot=10 squash=-0.08 ease=out_quad
  pose ribs f=3..3 dx=2->0 rot=4->0

// Shared Ranged Attack Profile (Draw/Aim Tension -> Release Snap + Flash -> Recoil Recovery)
tag ranged_attack frames=4 duration=75ms loop=once
  pose kopis visible=false f=0..3
  pose bone_bow visible=true f=0..1 dx=0->2 scale=1.10 squash=0.0->0.08
  pose bone_bow visible=true f=2..3 dx=3->0 scale=1.02 squash=-0.06->0.0 ease=out_quad
  pose arm_r f=0..1 dx=0->-4 rot=0->-22
  pose arm_r f=2..3 dx=3->0 rot=12->0 ease=out_quad
  pose ribs f=0..1 dx=0->-3 rot=0->-6 squash=0.0->0.06
  pose ribs f=2..3 dx=2->0 rot=5->0 squash=-0.08->0.0 ease=out_quad
  pose skull f=0..1 dx=0->-2
  pose skull f=2..3 dx=2->0
  pose range_flash visible=true f=2..2 dx=2 scale=1.2

tag hit frames=2 duration=90ms loop=once
  pose ribs dx=-4->0 squash=-0.15->0.0
  pose skull dx=-5->0 rot=-14->0

tag death frames=4 duration=100ms loop=once
  pose skull f=0..3 dy=0->18 dx=0->-8 rot=0->-65
  pose ribs f=0..3 dy=0->14 rot=0->50
  pose kopis f=0..3 dy=0->16 dx=0->6 rot=0->85
