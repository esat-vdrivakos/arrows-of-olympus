title "12 Gods of Olympus - Pantheon Battle Theme"
type song
tempo allegro 136
time 4/4

# 9 independent channels (1:1 inst-to-track relationship)
inst lyre_lead    wave=harp           vol=0.14 pan=-0.18
inst lyre_echo    wave=psg_square     vol=0.05 pan=0.22
inst athena_brass wave=ym2612_brass   vol=0.12 pan=-0.14
inst brass_harm   wave=ym2612_brass   vol=0.10 pan=0.20
inst olympus_pad  wave=ym2612_strings vol=0.09 pan=0.00
inst oracle_arp   wave=psg_arp        vol=0.06 pan=0.26
inst aulos_flute  wave=ym2612_flute   vol=0.11 pan=-0.24
inst war_bass     wave=ym2612_bass    vol=0.25 pan=0.00
inst titan_sub    wave=sub_bass       vol=0.25 pan=0.00
inst drums        wave=kick           vol=0.26 pan=0.00

# Section I: 4-bar Ceremonial Olympus Intro (Dm -> C -> Bb -> A5)
pattern lead_intro =
  D5:2 A4:8. D5 E5:8 | C5:2 G4:8. C5 D5:8 | Bb4:2 F4:8. Bb4 C5:8 | A4:1 |

pattern echo_intro =
  R:8 D5:2. A4:8 | R:8 C5:2. G4:8 | R:8 Bb4:2. F4:8 | R:8 A4:2. E4:8 |

pattern brass_intro =
  R:1 | R:1 | R:1 | A4:8. A4:8. A4:8 E5:2 |

pattern harm_intro =
  R:1 | R:1 | R:1 | E4:8. E4:8. E4:8 A4:2 |

pattern pad_intro =
  D4:1 | C4:1 | Bb3:1 | A3:1 |

pattern arp_intro =
  (D3 A3 D4 A4 D5 A4 D4 A3):16*2 |
  (C3 G3 C4 G4 C5 G4 C4 G3):16*2 |
  (Bb2 F3 Bb3 F4 Bb4 F4 Bb3 F3):16*2 |
  (A2 E3 A3 E4 A4 E4 A3 E3):16*2 |

pattern flute_intro =
  A4:1 | G4:1 | F4:1 | E4:1 |

pattern bass_intro =
  D2:8.*2 D2:8 D2:2 | C2:8.*2 C2:8 C2:2 | Bb1:8.*2 Bb1:8 Bb1:2 | A1:8.*2 A1:8 A1:2 |

pattern sub_intro =
  D1:1 | C1:1 | Bb1:1 | A1:1 |

pattern drum_intro =
  kick:2 R:2 | kick:2 R:2 | kick:4 R:4 kick:4 R:4 | kick:8 kick:8 snare:4 kick:4 (snare*2 tom_mid snare):16 |

# Section A: 8-bar Heroic Ascent (Apollo & Artemis Theme)
pattern lead_secA =
  (D5:4 A4:8 D5 F5:4 E5:8 D5 | C5:2 G4:4 C5:4 | Bb4:4 F4:8 Bb4 D5:4 C5:8 Bb4 | A4:2 E5:2 |)*2

pattern echo_secA =
  (R:8 D5:2. F5:8 | R:8 C5:2. G4:8 | R:8 Bb4:2. D5:8 | R:8 A4:2. E5:8 |)*2

pattern brass_secA =
  (D4:8. D4 F4:8 A4:4. R:8 | C4:8. C4 E4:8 G4:4. R:8 | Bb3:8. Bb3 D4:8 F4:4. R:8 | A3:8. A3 E4:8 A4:4. R:8 |)*2

pattern harm_secA =
  (A3:8. A3 D4:8 F4:4. R:8 | G3:8. G3 C4:8 E4:4. R:8 | F3:8. F3 Bb3:8 D4:4. R:8 | E3:8. E3 A3:8 E4:4. R:8 |)*2

pattern pad_secA =
  (D4:1 | C4:1 | Bb3:1 | A3:1 |)*2

pattern arp_secA =
  ((D3 A3 D4 A4 D5 A4 D4 A3):16*2 |
   (C3 G3 C4 G4 C5 G4 C4 G3):16*2 |
   (Bb2 F3 Bb3 F4 Bb4 F4 Bb3 F3):16*2 |
   (A2 E3 A3 E4 A4 E4 A3 E3):16*2 |)*2

pattern flute_secA =
  (R:1 | R:1 | R:1 | R:1 |
   F5:2 D5:2 | E5:2 C5:2 | D5:2 Bb4:2 | C5:2 A4:2 |)

pattern bass_secA =
  ((D1 D2):16*8 | (C1 C2):16*8 | (Bb1 Bb2):16*8 | (A1 A2):16*8 |)*2

pattern sub_secA =
  (D1:2 D1:2 | C1:2 C1:2 | Bb1:2 Bb1:2 | A1:2 A1:2 |)*2

pattern drum_secA =
  (kick:8. kick:16 snare:8 kick:4 kick:8 snare:4 |
   kick:8. kick:16 snare:8 kick:4 kick:8 snare:8 (tom_hi*2):16 |)*4

# Section B: 8-bar Twelve Olympians Climax (F -> C -> Dm -> Am | Bb -> C -> Dm -> A5)
pattern lead_secB =
  F5:2 C5:4 F5:4 | E5:2 C5:4 G5:4 | D5:2 A4:4 D5:4 | C5:2 A4:2 |
  Bb4:2 F4:4 D5:4 | C5:2 G4:4 E5:4 | D5:2 F5:4 E5:4 | A5:1 |

pattern echo_secB =
  R:8 F5:2. C5:8 | R:8 E5:2. G5:8 | R:8 D5:2. A4:8 | R:8 C5:2. A4:8 |
  R:8 Bb4:2. D5:8 | R:8 C5:2. E5:8 | R:8 D5:2. E5:8 | R:8 A5:2. E5:8 |

pattern brass_secB =
  A4:4. C5:8 F5:2 | G4:4. C5:8 E5:2 | F4:4. A4:8 D5:2 | E4:4. A4:8 C5:2 |
  D4:4. F4:8 Bb4:2 | E4:4. G4:8 C5:2 | F4:4. A4:8 D5:2 | E4:8. E4:8. E4:8 A4:2 |

pattern harm_secB =
  F4:4. A4:8 C5:2 | E4:4. G4:8 C5:2 | D4:4. F4:8 A4:2 | C4:4. E4:8 A4:2 |
  Bb3:4. D4:8 F4:2 | C4:4. E4:8 G4:2 | D4:4. F4:8 A4:2 | A3:8. A3:8. A3:8 E4:2 |

pattern pad_secB =
  F4:1 | E4:1 | D4:1 | C4:1 |
  Bb3:1 | C4:1 | D4:1 | E4:1 |

pattern arp_secB =
  (F3 C4 F4 C5 F5 C5 F4 C4):16*2 |
  (C3 G3 C4 G4 C5 G4 C4 G3):16*2 |
  (D3 A3 D4 A4 D5 A4 D4 A3):16*2 |
  (A2 E3 A3 E4 A4 E4 A3 E3):16*2 |
  (Bb2 F3 Bb3 F4 Bb4 F4 Bb3 F3):16*2 |
  (C3 G3 C4 G4 C5 G4 C4 G3):16*2 |
  (D3 A3 D4 A4 D5 A4 D4 A3):16*2 |
  (A2 E3 A3 E4 A4 E4 A3 E3):16*2 |

pattern flute_secB =
  C5:2 A4:2 | C5:2 G4:2 | A4:2 F4:2 | A4:2 E4:2 |
  F4:2 Bb4:2 | G4:2 C5:2 | A4:2 D5:2 | E5:1 |

pattern bass_secB =
  (F1 F2):16*8 | (C1 C2):16*8 | (D1 D2):16*8 | (A1 A2):16*8 |
  (Bb1 Bb2):16*8 | (C1 C2):16*8 | (D1 D2):16*8 | (A1 A2):16*8 |

pattern sub_secB =
  F1:2 F1:2 | C1:2 C1:2 | D1:2 D1:2 | A1:2 A1:2 |
  Bb1:2 Bb1:2 | C1:2 C1:2 | D1:2 D1:2 | A1:2 A1:2 |

pattern drum_secB =
  (kick:8. kick:16 snare:8 kick:4 kick:8 snare:4 |)*7
  kick:8 kick:8 snare:4 kick:4 (snare*2 tom_mid snare):16 |

#Tracks (28 bars total = 49.4s at 136 BPM)
track ch01 lyre_lead:    lead_intro  lead_secA  lead_secB  lead_secA
track ch02 lyre_echo:    echo_intro  echo_secA  echo_secB  echo_secA
track ch03 athena_brass: brass_intro brass_secA brass_secB brass_secA
track ch04 brass_harm:   harm_intro  harm_secA  harm_secB  harm_secA
track ch05 olympus_pad:  pad_intro   pad_secA   pad_secB   pad_secA
track ch06 oracle_arp:   arp_intro   arp_secA   arp_secB   arp_secA
track ch07 aulos_flute:  flute_intro flute_secA flute_secB flute_secA
track ch08 war_bass:     bass_intro  bass_secA  bass_secB  bass_secA
track ch09 titan_sub:    sub_intro   sub_secA   sub_secB   sub_secA
track ch10 drums:        drum_intro  drum_secA  drum_secB  drum_secA
